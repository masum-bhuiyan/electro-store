generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
  MANAGER
  SALES
  ACCOUNTS
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  COD
  BKASH
  NAGAD
  CARD
}

enum StockReason {
  PURCHASE
  SALE
  RETURN
  ADJUSTMENT
}

// খুচরা বা পাইকারি ক্রেতা
enum CustomerType {
  RETAIL
  WHOLESALE
}

model User {
  id                String    @id @default(cuid())
  name              String
  phone             String?   @unique
  email             String?   @unique
  password          String?
  role              Role      @default(CUSTOMER)
  isActive          Boolean   @default(true)
  extraPermissions  String[]  @default([])
  deniedPermissions String[]  @default([])
  addresses         Address[]
  orders            Order[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  failedLogins      Int       @default(0)
  lockedUntil       DateTime?
  sessions          Session[]
}

model Address {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName  String
  phone     String
  division  String
  district  String
  area      String
  details   String
  isDefault Boolean @default(false)

  @@index([userId])
}

model Category {
  id       String     @id @default(cuid())
  name     String
  slug     String     @unique
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]
}

model Brand {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  logo     String?
  products Product[]
}

model Product {
  id             String           @id @default(cuid())
  name           String
  slug           String           @unique
  description    String
  model          String?
  images         String[]
  specs          Json?
  warrantyMonths Int              @default(0)
  isActive       Boolean          @default(true)
  isFeatured     Boolean          @default(false)
  categoryId     String
  category       Category         @relation(fields: [categoryId], references: [id])
  brandId        String
  brand          Brand            @relation(fields: [brandId], references: [id])
  variants       ProductVariant[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([categoryId])
  @@index([brandId])
  @@index([isActive, isFeatured])
}

model ProductVariant {
  id             String          @id @default(cuid())
  productId      String
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku            String          @unique
  color          String?
  storage        String?
  price          Decimal         @db.Decimal(12, 2)
  comparePrice   Decimal?        @db.Decimal(12, 2)
  costPrice      Decimal?        @db.Decimal(12, 2)
  stock          Int             @default(0)
  stockMovements StockMovement[]
  orderItems     OrderItem[]
  purchaseItems  PurchaseItem[]
  purchaseReturnItems PurchaseReturnItem[]

  @@index([productId])
}

// ক্রেতার রেকর্ড (ডাটা ও হিসাবের জন্য)। এটা লগইন অ্যাকাউন্ট নয়
model Customer {
  id          String       @id @default(cuid())
  type        CustomerType @default(RETAIL)
  // খুচরায় ক্রেতার নাম, পাইকারিতে দোকানের নাম
  name        String
  // পাইকারিতে মালিক বা যোগাযোগের নাম (ঐচ্ছিক)
  contactName String?
  phone       String       @unique
  address     String?
  note        String?
  isActive    Boolean      @default(true)
  orders      Order[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([type])
}

// যাদের কাছ থেকে মাল কেনা হয়
model Supplier {
  id          String   @id @default(cuid())
  name        String
  contactName String?
  phone       String?
  address     String?
  note        String?
  isActive    Boolean  @default(true)
  purchases   Purchase[]
  purchaseReturns PurchaseReturn[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Order {
  id                  String        @id @default(cuid())
  orderNumber         String        @unique
  idempotencyKey      String?       @unique
  userId              String?
  user                User?         @relation(fields: [userId], references: [id])
  customerId          String?
  customer            Customer?     @relation(fields: [customerId], references: [id])
  customerName        String
  phone               String
  address             String
  status              OrderStatus   @default(PENDING)
  paymentMethod       PaymentMethod @default(COD)
  paymentStatus       PaymentStatus @default(UNPAID)
  subtotal            Decimal       @db.Decimal(12, 2)
  shippingFee         Decimal       @default(0) @db.Decimal(12, 2)
  // ক্রেতা অর্ডারের সময় যে এলাকা বেছেছিল ("dhaka" বা "outside"), পুরোনো অর্ডারে খালি
  shippingZone        String?
  // ক্রেতা অর্ডারের সময় যে ডেলিভারি চার্জ দেখেছিল, পুরোনো অর্ডারে খালি
  originalShippingFee Decimal?      @db.Decimal(12, 2)
  total               Decimal       @db.Decimal(12, 2)
  notes               String?
  items               OrderItem[]
  edits               OrderEdit[]
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([userId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id        String         @id @default(cuid())
  orderId   String
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  name      String
  unitPrice Decimal        @db.Decimal(12, 2)
  // অর্ডারের সময়ের আসল দাম (ছাড়ের শতাংশ বের করতে), পুরোনো অর্ডারে খালি
  listPrice Decimal?       @db.Decimal(12, 2)
  quantity  Int

  @@index([orderId])
}

// অর্ডারে দাম বা ডেলিভারি বদলের লগ: কে, কখন, কী বদলাল
model OrderEdit {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  staffName String
  summary   String
  reason    String?
  createdAt DateTime @default(now())

  @@index([orderId])
}

model StockMovement {
  id        String         @id @default(cuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  change    Int
  reason    StockReason
  note      String?
  createdAt DateTime       @default(now())

  @@index([variantId])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}
// মাল কেনার বিল (সাপ্লায়ার থেকে)
model Purchase {
  id             String         @id @default(cuid())
  purchaseNumber String         @unique
  supplierId     String
  supplier       Supplier       @relation(fields: [supplierId], references: [id])
  // সাপ্লায়ারের নিজের বিল নম্বর (ঐচ্ছিক)
  billNo         String?
  total          Decimal        @db.Decimal(12, 2)
  // বিলের সময় যত টাকা দেওয়া হয়েছে
  paid           Decimal        @default(0) @db.Decimal(12, 2)
  note           String?
  staffName      String
  items          PurchaseItem[]
  returns        PurchaseReturn[]
  createdAt      DateTime       @default(now())

  @@unique([supplierId, billNo])
  @@index([supplierId])
  @@index([createdAt])
}

model PurchaseItem {
  id         String         @id @default(cuid())
  purchaseId String
  purchase   Purchase       @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  variantId  String
  variant    ProductVariant @relation(fields: [variantId], references: [id])
  name       String
  quantity   Int
  unitCost   Decimal        @db.Decimal(12, 2)
  // এই ক্রয়ে বিক্রয় দাম বদলালে আগের ও নতুন দাম (না বদলালে খালি)
  oldPrice   Decimal?       @db.Decimal(12, 2)
  newPrice   Decimal?       @db.Decimal(12, 2)
  returnItems PurchaseReturnItem[]

  @@index([purchaseId])
  @@index([variantId])
}
// সাপ্লায়ারকে মাল ফেরত
model PurchaseReturn {
  id             String               @id @default(cuid())
  returnNumber   String               @unique
  purchaseId     String
  purchase       Purchase             @relation(fields: [purchaseId], references: [id])
  supplierId     String
  supplier       Supplier             @relation(fields: [supplierId], references: [id])
  // ফেরত দেওয়া মালের মূল্য
  total          Decimal              @db.Decimal(12, 2)
  // সাপ্লায়ার নগদ ফেরত দিলে সেই টাকা (০ হলে বাকি/ক্রেডিট থেকে বাদ)
  cashReceived   Decimal              @default(0) @db.Decimal(12, 2)
  note           String?
  staffName      String
  items          PurchaseReturnItem[]
  createdAt      DateTime             @default(now())

  @@index([purchaseId])
  @@index([supplierId])
  @@index([createdAt])
}

model PurchaseReturnItem {
  id             String         @id @default(cuid())
  returnId       String
  return         PurchaseReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  purchaseItemId String
  purchaseItem   PurchaseItem   @relation(fields: [purchaseItemId], references: [id])
  variantId      String
  variant        ProductVariant @relation(fields: [variantId], references: [id])
  name           String
  quantity       Int
  unitCost       Decimal        @db.Decimal(12, 2)

  @@index([returnId])
  @@index([purchaseItemId])
}