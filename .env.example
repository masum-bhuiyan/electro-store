# Neon pooled লিংক (হোস্টের নামে -pooler থাকে)। সাইট চালানোর জন্য
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Neon direct লিংক (-pooler নেই)। শুধু migrate-এর জন্য, ঐচ্ছিক
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require"

# শুধু dev ডাটাবেসের .env-এ। লাইভে কখনো না
ALLOW_SEED="yes"

# সাইটের আসল ঠিকানা, ঐচ্ছিক
SITE_URL=""
