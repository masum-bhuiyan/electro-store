generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
  MANAGER
  SALES
  ACCOUNTS
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  COD
  BKASH
  NAGAD
  CARD
}

enum StockReason {
  PURCHASE
  SALE
  RETURN
  ADJUSTMENT
}

// খুচরা বা পাইকারি ক্রেতা
enum CustomerType {
  RETAIL
  WHOLESALE
}

model User {
  id                String    @id @default(cuid())
  name              String
  phone             String?   @unique
  email             String?   @unique
  password          String?
  role              Role      @default(CUSTOMER)
  isActive          Boolean   @default(true)
  extraPermissions  String[]  @default([])
  deniedPermissions String[]  @default([])
  addresses         Address[]
  orders            Order[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  failedLogins      Int       @default(0)
  lockedUntil       DateTime?
  sessions          Session[]
}

model Address {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName  String
  phone     String
  division  String
  district  String
  area      String
  details   String
  isDefault Boolean @default(false)

  @@index([userId])
}

model Category {
  id       String     @id @default(cuid())
  name     String
  slug     String     @unique
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]
}

model Brand {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  logo     String?
  products Product[]
}

model Product {
  id             String           @id @default(cuid())
  name           String
  slug           String           @unique
  description    String
  model          String?
  images         String[]
  specs          Json?
  warrantyMonths Int              @default(0)
  isActive       Boolean          @default(true)
  isFeatured     Boolean          @default(false)
  categoryId     String
  category       Category         @relation(fields: [categoryId], references: [id])
  brandId        String
  brand          Brand            @relation(fields: [brandId], references: [id])
  variants       ProductVariant[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([categoryId])
  @@index([brandId])
  @@index([isActive, isFeatured])
}

model ProductVariant {
  id             String          @id @default(cuid())
  productId      String
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku            String          @unique
  // প্রস্তুতকারকের ছাপা বারকোড (ঐচ্ছিক)। স্ক্যানারে খোঁজার জন্য
  barcode        String?         @unique
  color          String?
  storage        String?
  price          Decimal         @db.Decimal(12, 2)
  comparePrice   Decimal?        @db.Decimal(12, 2)
  costPrice      Decimal?        @db.Decimal(12, 2)
  stock          Int             @default(0)
  stockMovements StockMovement[]
  orderItems     OrderItem[]
  purchaseItems  PurchaseItem[]
  purchaseReturnItems PurchaseReturnItem[]
  saleItems           SaleItem[]
 saleReturnItems     SaleReturnItem[]

  @@index([productId])
}

// ক্রেতার রেকর্ড (ডাটা ও হিসাবের জন্য)। এটা লগইন অ্যাকাউন্ট নয়
model Customer {
  id          String       @id @default(cuid())
  type        CustomerType @default(RETAIL)
  // খুচরায় ক্রেতার নাম, পাইকারিতে দোকানের নাম
  name        String
  // পাইকারিতে মালিক বা যোগাযোগের নাম (ঐচ্ছিক)
  contactName String?
  phone       String       @unique
  address     String?
  note        String?
  isActive    Boolean      @default(true)
  orders      Order[]
  sales       Sale[]
  payments    CustomerPayment[]
  saleReturns SaleReturn[]
  // চালুর সময়ের পুরনো বাকি। ধনাত্মক = ক্রেতা আমাদের দেবে, ঋণাত্মক = ক্রেতার জমা। একবারই বসানো যায়
  openingBalance Decimal   @default(0) @db.Decimal(12, 2)
  openingSetAt   DateTime?
  openingSetBy   String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([type])
}

// যাদের কাছ থেকে মাল কেনা হয়
model Supplier {
  id          String   @id @default(cuid())
  name        String
  contactName String?
  phone       String?
  address     String?
  note        String?
  isActive    Boolean  @default(true)
  purchases   Purchase[]
  purchaseReturns PurchaseReturn[]
  payments    SupplierPayment[]
  // চালুর সময়ের পুরনো বাকি। ধনাত্মক = আমরা সাপ্লায়ারকে দেব, ঋণাত্মক = সাপ্লায়ার আমাদের দেবে
  openingBalance Decimal   @default(0) @db.Decimal(12, 2)
  openingSetAt   DateTime?
  openingSetBy   String?
  expenses    Expense[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Order {
  id                  String        @id @default(cuid())
  orderNumber         String        @unique
  idempotencyKey      String?       @unique
  userId              String?
  user                User?         @relation(fields: [userId], references: [id])
  customerId          String?
  customer            Customer?     @relation(fields: [customerId], references: [id])
  customerName        String
  phone               String
  address             String
  status              OrderStatus   @default(PENDING)
  paymentMethod       PaymentMethod @default(COD)
  paymentStatus       PaymentStatus @default(UNPAID)
  subtotal            Decimal       @db.Decimal(12, 2)
  shippingFee         Decimal       @default(0) @db.Decimal(12, 2)
  // ক্রেতা অর্ডারের সময় যে এলাকা বেছেছিল ("dhaka" বা "outside"), পুরোনো অর্ডারে খালি
  shippingZone        String?
  // ক্রেতা অর্ডারের সময় যে ডেলিভারি চার্জ দেখেছিল, পুরোনো অর্ডারে খালি
  originalShippingFee Decimal?      @db.Decimal(12, 2)
  total               Decimal       @db.Decimal(12, 2)
  notes               String?
  items               OrderItem[]
  edits               OrderEdit[]
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([userId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id        String         @id @default(cuid())
  orderId   String
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  name      String
  unitPrice Decimal        @db.Decimal(12, 2)
  // অর্ডারের সময়ের আসল দাম (ছাড়ের শতাংশ বের করতে), পুরোনো অর্ডারে খালি
  listPrice Decimal?       @db.Decimal(12, 2)
  quantity  Int

  @@index([orderId])
}

// অর্ডারে দাম বা ডেলিভারি বদলের লগ: কে, কখন, কী বদলাল
model OrderEdit {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  staffName String
  summary   String
  reason    String?
  createdAt DateTime @default(now())

  @@index([orderId])
}

model StockMovement {
  id        String         @id @default(cuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  change    Int
  reason    StockReason
  note      String?
  createdAt DateTime       @default(now())

  @@index([variantId])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}
// মাল কেনার বিল (সাপ্লায়ার থেকে)
model Purchase {
  id             String         @id @default(cuid())
  purchaseNumber String         @unique
  supplierId     String
  supplier       Supplier       @relation(fields: [supplierId], references: [id])
  // সাপ্লায়ারের নিজের বিল নম্বর (ঐচ্ছিক)
  billNo         String?
  total          Decimal        @db.Decimal(12, 2)
  // বিলের সময় যত টাকা দেওয়া হয়েছে
  paid           Decimal        @default(0) @db.Decimal(12, 2)
  note           String?
  staffName      String
  items          PurchaseItem[]
  returns        PurchaseReturn[]
  createdAt      DateTime       @default(now())

  @@unique([supplierId, billNo])
  @@index([supplierId])
  @@index([createdAt])
}

model PurchaseItem {
  id         String         @id @default(cuid())
  purchaseId String
  purchase   Purchase       @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  variantId  String
  variant    ProductVariant @relation(fields: [variantId], references: [id])
  name       String
  quantity   Int
  unitCost   Decimal        @db.Decimal(12, 2)
  // এই ক্রয়ে বিক্রয় দাম বদলালে আগের ও নতুন দাম (না বদলালে খালি)
  oldPrice   Decimal?       @db.Decimal(12, 2)
  newPrice   Decimal?       @db.Decimal(12, 2)
  returnItems PurchaseReturnItem[]

  @@index([purchaseId])
  @@index([variantId])
}
// সাপ্লায়ারকে মাল ফেরত
model PurchaseReturn {
  id             String               @id @default(cuid())
  returnNumber   String               @unique
  purchaseId     String
  purchase       Purchase             @relation(fields: [purchaseId], references: [id])
  supplierId     String
  supplier       Supplier             @relation(fields: [supplierId], references: [id])
  // ফেরত দেওয়া মালের মূল্য
  total          Decimal              @db.Decimal(12, 2)
  // সাপ্লায়ার নগদ ফেরত দিলে সেই টাকা (০ হলে বাকি/ক্রেডিট থেকে বাদ)
  cashReceived   Decimal              @default(0) @db.Decimal(12, 2)
  note           String?
  staffName      String
  items          PurchaseReturnItem[]
  createdAt      DateTime             @default(now())

  @@index([purchaseId])
  @@index([supplierId])
  @@index([createdAt])
}

model PurchaseReturnItem {
  id             String         @id @default(cuid())
  returnId       String
  return         PurchaseReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  purchaseItemId String
  purchaseItem   PurchaseItem   @relation(fields: [purchaseItemId], references: [id])
  variantId      String
  variant        ProductVariant @relation(fields: [variantId], references: [id])
  name           String
  quantity       Int
  unitCost       Decimal        @db.Decimal(12, 2)

  @@index([returnId])
  @@index([purchaseItemId])
}
// পেমেন্টের মাধ্যম (দোকানের বিক্রয়ে)
enum SalePayMethod {
  CASH
  BKASH
  NAGAD
  BANK
}
// বিক্রয়ের অবস্থা: ড্রাফটে স্টক আটকে থাকে, কনফার্মে বিক্রয় চূড়ান্ত
enum SaleStatus {
  DRAFT
  CONFIRMED
}

// দোকানের (POS) বিক্রয়
model Sale {
  id           String        @id @default(cuid())
  saleNumber   String        @unique
  // পুরনো সব বিক্রয় CONFIRMED হিসেবেই থাকবে
  status       SaleStatus    @default(CONFIRMED)
  // সেভ করা ক্রেতা। walk-in হলে খালি
  customerId   String?
  customer     Customer?     @relation(fields: [customerId], references: [id])
  // বিক্রির সময়ের ক্রেতার ধরন। পরে ক্রেতার ধরন বদলালেও পুরনো রিপোর্ট বদলাবে না
  customerType CustomerType  @default(RETAIL)
  // মেমোতে দেখানোর জন্য বিক্রির সময়ের নাম ও ফোন
  customerName String?
  customerPhone String?
  subtotal     Decimal       @db.Decimal(12, 2)
  // বিল বন্ধ করতে দেওয়া অতিরিক্ত ছাড়। subtotal এই ছাড়ের পরের প্রদেয় মোট
  extraDiscount Decimal      @default(0) @db.Decimal(12, 2)
  paid         Decimal       @default(0) @db.Decimal(12, 2)
  payMethod    SalePayMethod @default(CASH)
  note         String?
  staffName    String
  items        SaleItem[]
  edits        SaleEdit[]
  returns      SaleReturn[]
  createdAt    DateTime      @default(now())

  @@index([customerId])
  @@index([createdAt])
  @@index([customerType])
  @@index([status])
}

model SaleItem {
  id        String         @id @default(cuid())
  saleId    String
  sale      Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  name      String
  quantity  Int
  // বিক্রির সময়ের আসল দাম (ছাড় বের করতে)
  listPrice Decimal        @db.Decimal(12, 2)
  // আসলে যে দামে বিক্রি হলো
  unitPrice Decimal        @db.Decimal(12, 2)
  // বিক্রির সময়ের গড় কেনা দাম (লাভ বের করতে)। দাম না থাকলে খালি
  unitCost  Decimal?       @db.Decimal(12, 2)

  returnItems SaleReturnItem[]
  @@index([saleId])
  @@index([variantId])
}

// কনফার্ম হওয়া বিক্রয়ের সংশোধনের লগ: কে, কখন, কী বদলাল
model SaleEdit {
  id        String   @id @default(cuid())
  saleId    String
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  staffName String
  summary   String
  reason    String?
  createdAt DateTime @default(now())

  @@index([saleId])
}

// ক্রেতার কাছ থেকে পরে বাকি আদায় (মোট বাকিতে, বিল-ভিত্তিক নয়)
model CustomerPayment {
  id            String        @id @default(cuid())
  paymentNumber String        @unique
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id])
  amount        Decimal       @db.Decimal(12, 2)
  method        SalePayMethod @default(CASH)
  // রসিদের জন্য সেভের সময়ের হিসাব। ঋণাত্মক মানে ক্রেতার জমা আছে
  balanceBefore Decimal       @db.Decimal(12, 2)
  balanceAfter  Decimal       @db.Decimal(12, 2)
  note          String?
  staffName     String
  createdAt     DateTime      @default(now())

  @@index([customerId])
  @@index([createdAt])
}

// সাপ্লায়ারকে বিলের পরে টাকা দেওয়া
model SupplierPayment {
  id            String        @id @default(cuid())
  paymentNumber String        @unique
  supplierId    String
  supplier      Supplier      @relation(fields: [supplierId], references: [id])
  amount        Decimal       @db.Decimal(12, 2)
  method        SalePayMethod @default(CASH)
  // ঋণাত্মক মানে সাপ্লায়ার আপনাকে দেবে
  balanceBefore Decimal       @db.Decimal(12, 2)
  balanceAfter  Decimal       @db.Decimal(12, 2)
  note          String?
  staffName     String
  createdAt     DateTime      @default(now())

  @@index([supplierId])
  @@index([createdAt])
}
// ক্রেতার কাছ থেকে মাল ফেরত নেওয়া (কনফার্ম হওয়া বিক্রয় থেকে)
model SaleReturn {
  id           String           @id @default(cuid())
  returnNumber String           @unique
  saleId       String
  sale         Sale             @relation(fields: [saleId], references: [id])
  // walk-in হলে খালি
  customerId   String?
  customer     Customer?        @relation(fields: [customerId], references: [id])
  // ফেরত নেওয়া মালের মূল্য (বিলের অতিরিক্ত ছাড়ের অনুপাতে কমানো)
  total        Decimal          @db.Decimal(12, 2)
  // ক্রেতার বাকি থেকে যত কাটা হয়েছে
  creditAmount Decimal          @default(0) @db.Decimal(12, 2)
  // ক্রেতাকে যত নগদ ফেরত দেওয়া হয়েছে
  cashRefund   Decimal          @default(0) @db.Decimal(12, 2)
  note         String?
  staffName    String
  items        SaleReturnItem[]
  createdAt    DateTime         @default(now())

  @@index([saleId])
  @@index([customerId])
  @@index([createdAt])
}

model SaleReturnItem {
  id         String         @id @default(cuid())
  returnId   String
  return     SaleReturn     @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleItemId String
  saleItem   SaleItem       @relation(fields: [saleItemId], references: [id])
  variantId  String
  variant    ProductVariant @relation(fields: [variantId], references: [id])
  name       String
  quantity   Int
  // বিক্রির সময়ের দাম
  unitPrice  Decimal        @db.Decimal(12, 2)
  // গড় কেনা দাম (লাভের হিসাবে ফেরত বাদ দিতে)
  unitCost   Decimal?       @db.Decimal(12, 2)
  // এই লাইনে ফেরতের মূল্য
  amount     Decimal        @db.Decimal(12, 2)

  @@index([returnId])
  @@index([saleItemId])
}

// খরচের ক্যাটাগরি (দোকান ভাড়া, বেতন ইত্যাদি)। মোছা যায় না, শুধু বন্ধ করা যায়
model ExpenseCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  expenses  Expense[]
  createdAt DateTime  @default(now())
}

// দোকানের খরচ। বদলানো বা মোছা যায় না, ভুল হলে "বাতিল" করা হয়
model Expense {
  id            String          @id @default(cuid())
  expenseNumber String          @unique
  categoryId    String
  category      ExpenseCategory @relation(fields: [categoryId], references: [id])
  amount        Decimal         @db.Decimal(12, 2)
  method        SalePayMethod   @default(CASH)
  // খরচ যেদিন হয়েছে (ঢাকার তারিখ)
  expenseDate   DateTime
  note          String?
  // কোন সাপ্লায়ার সংক্রান্ত খরচ (ঐচ্ছিক)
  supplierId    String?
  supplier      Supplier?       @relation(fields: [supplierId], references: [id])
  staffName     String
  voidedAt      DateTime?
  voidedBy      String?
  voidReason    String?
  createdAt     DateTime        @default(now())

  @@index([expenseDate])
  @@index([categoryId])
  @@index([supplierId])
}

// ক্যাশ বুকের হাতে লেখা এন্ট্রি: শুরুর জমা, মালিকের জমা, মালিকের তোলা
enum CashEntryKind {
  OPENING
  DEPOSIT
  WITHDRAW
  TRANSFER
}

model CashEntry {
  id         String        @id @default(cuid())
  entryNumber String       @unique
  kind       CashEntryKind
  method     SalePayMethod
  amount     Decimal       @db.Decimal(12, 2)
  // শুধু TRANSFER-এ: কোন মাধ্যমে টাকা গেল (method = যেখান থেকে গেল)
  toMethod   SalePayMethod?
  // শুধু TRANSFER-এ: ব্যাংক/bKash চার্জ। এর জন্য একটা খরচ (Expense) নিজে তৈরি হয়
  charge     Decimal       @default(0) @db.Decimal(12, 2)
  chargeExpenseId String?
  entryDate  DateTime
  note       String?
  staffName  String
  voidedAt   DateTime?
  voidedBy   String?
  voidReason String?
  createdAt  DateTime      @default(now())

  @@index([method, entryDate])
